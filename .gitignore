# XcodeGen output (generated locally/CI with `xcodegen generate`)
*.xcodeproj/
*.xcworkspace/

# Build
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM.zip

# Signing / secrets — never commit
*.p8
*.p12
*.mobileprovision
private_keys/

# macOS
.DS_Store

# OTA upload secrets
tools/.r2.env

# backups (never bundle/commit)
*.bak

# backup snapshots (keep on disk, never bundle/commit)
*.bak_*
_images_bak*/

# python cache
__pycache__/
*.pyc
